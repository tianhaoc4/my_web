<DOCTYPE html>
<html lang="zh-CN">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>北京大学录取升学宴邀请函</title>


<style>file:///data/user/0/com.foxdebug.acode/fi!les/public/升学宴请柬/index.html

*{
margin:0;
padding:0;
box-sizing:border-box;
}


body{

height:100vh;
overflow:hidden;

font-family:
"Microsoft YaHei",
serif;

background:#8b0000;

}



/*背景*/

.bg{

position:fixed;
width:100%;
height:100%;

background:

linear-gradient(
rgba(120,0,0,.55),
rgba(120,0,0,.55)
),

url("background.jpg")

center/cover no-repeat;


z-index:-2;

}



/*封面*/

.cover{

position:absolute;
width:100%;
height:100%;

display:flex;
align-items:center;
justify-content:center;

background:#8b0000;

animation:
hideCover 2s 2s forwards;

z-index:5;

}


.cover h1{

color:#ffd700;

font-size:42px;

letter-spacing:8px;

animation:
zoom 2s;

}


@keyframes zoom{

from{
transform:scale(.3);
opacity:0;
}

to{
transform:scale(1);
opacity:1;
}

}



@keyframes hideCover{

to{

opacity:0;
visibility:hidden;

}

}




/*请柬主体*/

.card{

position:absolute;

top:50%;
left:50%;

transform:
translate(-50%,-50%);


width:88%;
max-width:430px;


background:

rgba(255,245,220,.92);


border-radius:25px;


padding:30px 25px;


text-align:center;


box-shadow:

0 0 40px gold;


animation:

show 2s 2s backwards;

}



@keyframes show{

from{

opacity:0;

transform:
translate(-50%,20%);

}

to{

opacity:1;

transform:
translate(-50%,-50%);

}

}



/*校徽区域*/

.logo{

width:90px;

height:90px;

margin:auto;

border-radius:50%;

border:

4px solid #d4af37;


display:flex;

align-items:center;

justify-content:center;


color:#a00000;

font-size:20px;

font-weight:bold;


background:#fff8dc;


}


.logo img{

width:80px;

height:80px;

border-radius:50%;

}



.title{

margin-top:15px;

font-size:30px;

font-weight:bold;

color:#990000;

}



.subtitle{

color:#b8860b;

font-size:18px;

margin:10px;

}



.name{

font-size:42px;

font-weight:bold;

color:#a00000;

margin:20px;

}



.info{

font-size:18px;

line-height:2.2;

color:#5b3000;

}



.highlight{

font-size:24px;

color:#990000;

font-weight:bold;

}



.footer{

margin-top:20px;

font-size:20px;

color:#a00000;

}



/*花瓣*/

.flower{

position:absolute;

top:-20px;

font-size:25px;

animation:

fall linear infinite;

}


@keyframes fall{

from{

transform:
translateY(-10vh)
rotate(0deg);

}

to{

transform:
translateY(110vh)
rotate(360deg);

}

}



</style>

</head>



<body>


<div class="bg"></div>


<div class="cover">

<h1>
北京大学 · 金榜题名
</h1>

</div>



<div class="card">


<div class="logo">

<img src="pku-logo.png"
onerror="this.style.display='none'">

<span>
北大
</span>

</div>



<div class="title">

升学庆贺宴

</div>


<div class="subtitle">

喜报 · 榜上有名

</div>


<div class="name">

蔡浩天

</div>



<div class="info">


<p>
🎓 荣获 <span class="highlight">
北京大学录取
</span>
</p>


<p>
诚邀您共同见证<br>
人生新篇章
</p>


<br>


<p>
📅 2026年8月4日
</p>


<p>
📍 鼎福楼二楼
</p>



</div>



<div class="footer">

敬备薄宴 · 恭候光临

</div>


</div>




<script>


for(let i=0;i<35;i++){


let f=document.createElement("div");


f.className="flower";


f.innerHTML="🌸";


f.style.left=
Math.random()*100+"%";


f.style.animationDuration=
(5+Math.random()*7)+"s";


f.style.animationDelay=
Math.random()*5+"s";


document.body.appendChild(f);


}


</script>


</body>

</html>
